# ─────────────────────────────────────────────────────────────────────
# ALTERNATIVE DEPLOYMENT — Sequential workflow з deterministic routing.
#
# Для цього воркшопу МИ ВИКОРИСТОВУЄМО Option B — parent assistant
# з `assistant_ids` (sub-assistants, LangGraph handoff supervisor).
# Деталі: ./HOW_TO_DEPLOY.md
#
# Цей файл збережений як reference-варіант для deterministic routing у
# CodeMie Sequential workflow. Корисний для regulated flows (NBU audit,
# compliance-first) де LLM-based routing у parent-а не прийнятний.
#
# Щоб задеплоїти цей варіант — Workflows → + Create Workflow →
# перемкни View у YAML → встав все нижче (окрім цього коментаря) → Save.
# ─────────────────────────────────────────────────────────────────────

# CodeMie Workflow · Loan Copilot supervisor pattern
# ----------------------------------------------------------------------------
# Відтворює src/orchestrator.py як CodeMie workflow.
#
# Supervisor = сам workflow engine. Routing — через `next.condition`
# проти context store (детерміновано, без LLM на routing).
#
# АРХІТЕКТУРА (всі state'и — LLM, бо Transform Node не доступний
# у цьому CodeMie tenant):
#   intake-state         ← LLM intake-agent
#   kyc-state            ← LLM kycagent (з explicit lookup dict у prompt'і)
#   credit-history-state ← LLM credithistoryagent (з explicit lookup dict)
#   underwriter-state    ← LLM underwriter
#
# LLM з temperature=0 та explicit lookup table поводиться детерміновано
# та дає ті самі результати що й Python-версія common/scenario_data.
#
# ПЕРЕДУМОВИ:
#   У CodeMie створені 4 assistant'и зі slug'ами:
#     intake-agent, kycagent, credithistoryagent, underwriter
#   (всі з temperature=0 для детермінованої mock-поведінки)
#
# ІНСТРУКЦІЯ:
#   1. Workflows → + Create Workflow → YAML view → paste → Save.
#   2. Start Execution → payload з demo_payloads.md.
#
# Context store:
#   full_name, tax_id, phone, email, monthly_income, amount, term_months, purpose
#   intake_complete, kyc_passed, reason, credit_score, decision, rate_apr
# ----------------------------------------------------------------------------

name: loan-copilot-supervisor
description: >
  Consumer loan processing: Intake → KYC → CreditHistory → Underwriter.
mode: Sequential

# ----------------------------------------------------------------------------
# ASSISTANTS — reference на вже створених у CodeMie
# ----------------------------------------------------------------------------
assistants:
  - id: intake
    assistant_id: intake-agent
  - id: kyc
    assistant_id: kycagent
  - id: credit-history
    assistant_id: credithistoryagent
  - id: underwriter
    assistant_id: underwriter

# ----------------------------------------------------------------------------
# STATES
# ----------------------------------------------------------------------------
states:

  # ──────────── 1. INTAKE (LLM) ────────────
  - id: intake-state
    assistant_id: intake
    task: |
      Збери структуровану заявку з повідомлення клієнта.
      Поверни JSON за output_schema. Якщо не вистачає обов'язкових полів —
      став intake_complete=false і перерахуй missing_fields.
    output_schema: |
      {
        "type": "object",
        "properties": {
          "full_name":       {"type": "string"},
          "tax_id":          {"type": "string"},
          "phone":           {"type": "string"},
          "email":           {"type": "string"},
          "monthly_income":  {"type": "number"},
          "amount":          {"type": "number"},
          "term_months":     {"type": "integer"},
          "purpose":         {"type": "string"},
          "intake_complete": {"type": "boolean"},
          "missing_fields":  {"type": "array", "items": {"type": "string"}}
        },
        "required": ["intake_complete"]
      }
    resolve_dynamic_values_in_prompt: true
    next:
      condition:
        expression: "intake_complete == True"
        then: kyc-state
        otherwise: end

  # ──────────── 2. KYC (LLM з explicit lookup) ────────────
  - id: kyc-state
    assistant_id: kyc
    task: |
      KYC lookup для tax_id = "{{tax_id}}".

      Використай ТОЧНО цю таблицю (без імпровізації):
        "1234567890" → kyc_passed=true,  reason="clean"
        "9876543210" → kyc_passed=true,  reason="clean"
        "5555555555" → kyc_passed=false, reason="sanctions hit"
        <будь-що інше> → kyc_passed=true, reason="clean" (default)

      Якщо tax_id не 10 цифр → kyc_passed=false, reason="invalid tax_id format".
      Поверни JSON.
    output_schema: |
      {
        "type": "object",
        "properties": {
          "kyc_passed": {"type": "boolean"},
          "reason":     {"type": "string"}
        },
        "required": ["kyc_passed"]
      }
    resolve_dynamic_values_in_prompt: true
    next:
      condition:
        expression: "kyc_passed == True"
        then: credit-history-state
        otherwise: end

  # ──────────── 3. CREDIT HISTORY (LLM з explicit lookup) ────────────
  - id: credit-history-state
    assistant_id: credit-history
    task: |
      Credit score lookup для tax_id = "{{tax_id}}".

      Використай ТОЧНО цю таблицю (без імпровізації):
        "1234567890" → 720
        "9876543210" → 580
        "5555555555" → 650
        <будь-що інше> → 650 (default)

      Поверни JSON.
    output_schema: |
      {
        "type": "object",
        "properties": {
          "credit_score": {"type": "integer"}
        },
        "required": ["credit_score"]
      }
    resolve_dynamic_values_in_prompt: true
    next:
      condition:
        expression: "credit_score >= 500"
        then: underwriter-state
        otherwise: end

  # ──────────── 4. UNDERWRITER (LLM) ────────────
  - id: underwriter-state
    assistant_id: underwriter
    task: |
      На основі даних прийми фінальне рішення по кредиту:
        - amount: {{amount}}
        - term_months: {{term_months}}
        - monthly_income: {{monthly_income}}
        - credit_score: {{credit_score}}
      Застосуй 4-tier policy (див. system prompt). PTI = monthly_payment / monthly_income.
      Поверни JSON.
    # interrupt_before: true   # розкоментуй для HITL gate перед approve
    output_schema: |
      {
        "type": "object",
        "properties": {
          "decision": {"type": "string", "enum": ["approve", "decline", "manual_review"]},
          "rate_apr": {"type": ["number", "null"]},
          "reason":   {"type": "string"}
        },
        "required": ["decision"]
      }
    resolve_dynamic_values_in_prompt: true
    next:
      state_id: end
      store_in_context: true

# ----------------------------------------------------------------------------
# WORKFLOW SETTINGS
# ----------------------------------------------------------------------------
recursion_limit: 50
max_concurrency: 1           # послідовно (NBU audit)
enable_summarization_node: false

# ----------------------------------------------------------------------------
# NOTE про Transform Node
# ----------------------------------------------------------------------------
# docs.codemie.ai документує Transform Node (type: transform_node) з
# `type: script` для Python expressions — ідеально для deterministic lookup.
# Але у цьому tenant (CodeMie 2.59.0) Transform Node НЕ зареєстрований
# серед доступних custom node types (dropdown показує лише:
#   Generate Document Tree, Result Finalizer, State Processor,
#   Summarize Conversation, Supervisor).
# Тому mock lookup реалізовано через LLM-assistant з explicit lookup table
# у task prompt та temperature=0 на assistant level — поведінка все одно
# детермінована, але LLM-call замість Python exec.
#
# ЯКЩО Transform Node з'явиться у tenant — замінити kyc-state /
# credit-history-state на custom_node_id (приклад у коміті 088ebb7).
# ----------------------------------------------------------------------------
