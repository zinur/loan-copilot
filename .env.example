# ──────────────────────── DIAL (EPAM AI Proxy) ────────────────────────
# Primary provider — той самий ключ, що й у CodeMie Assistant settings.
# Отримати: ai-proxy UI → Keys section (або через CodeMie profile dump).
DIAL_API_KEY=
DIAL_API_URL=https://ai-proxy.lab.epam.com/openai
DIAL_API_VERSION=2024-10-21

# DIAL model (повна версія з датою; див. list моделей у DIAL UI)
# Приклади:
#   gpt-4o-mini-2024-07-18
#   gpt-4.1-2025-04-14
#   anthropic.claude-3-5-sonnet-20241022-v2:0
#   anthropic.claude-opus-4-20250514-v1:0
# DIAL_MODEL=gpt-4o-mini-2024-07-18

# ──────────────────────── Fallback: direct OpenAI ────────────────────────
# Використовується якщо DIAL_* не заповнений.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ──────────────────────── Fallback: direct Anthropic ─────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ──────────────────────── Routing ────────────────────────
# auto (default) → dial > openai > anthropic у порядку наявності ключів
# values: dial | openai | anthropic | auto
LLM_PROVIDER=auto

# ──────────────────────── W4 observability (поки опціонально) ────────────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=loan-copilot
